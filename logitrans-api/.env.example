# Copia este archivo como .env y cambia los valores.
# En SRV-LOGI01 el .env lleva permisos NTFS: solo lectura para NT AUTHORITY\LocalService (cuenta del servicio) y Administradores.

NODE_ENV=development
PUERTO=3000

# Origen del frontend (CORS y enlaces de verificación de correo)
ORIGEN=http://localhost:5173

# Base de datos PostgreSQL local (cuenta con privilegios mínimos app_logitrans, solo 127.0.0.1)
DATABASE_URL="postgresql://app_logitrans:AppLogiTrans-2026.Segura@127.0.0.1:5432/logitrans?schema=public"

# Secretos — genera cada uno con: npm run generar-clave
JWT_SECRET=cambia-esto-por-64-caracteres-hex
CLAVE_CIFRADO=cambia-esto-por-64-caracteres-hex

# Cookie Secure: true en producción (HTTPS). En localhost Chrome/Firefox la aceptan aunque sea http.
COOKIE_SECURE=true

# Active Directory (LDAPS)
LDAP_URL=ldaps://srv-logi01.logitrans.local:636
LDAP_BASE_DN=OU=LogiTrans,DC=logitrans,DC=local
LDAP_DOMINIO=logitrans.local
CA_CERT=./certs/logitrans-ca.cer
LDAP_SVC_USER=svc_logitrans@logitrans.local
LDAP_SVC_PASS=cambia-esto

# --- SOLO LABORATORIO ---
# Si no tienes Active Directory, AD_SIMULADO=true habilita 4 usuarios de prueba
# (ana.torres = ADMINISTRADOR, maria.lopez = EMPLEADO, juan.perez y carlos.ruiz = CHOFER)
# con la contraseña de abajo.
# El servidor se niega a arrancar si AD_SIMULADO=true y NODE_ENV=production.
AD_SIMULADO=true
AD_SIMULADO_PASSWORD="Laboratorio#2026"   # entre comillas: sin ellas, # inicia un comentario
