// Modelo de datos de LogiTrans (PostgreSQL).
// Las tablas se crean con base-de-datos/crear_base_de_datos.sql (rol dueño
// logitrans_admin); la app solo usa este esquema para generar el cliente:
//   npx prisma generate
// En el código los campos van en camelCase; en la base, en snake_case (@map).
// Todas las llaves son UUID v7 generados por PostgreSQL 18 (uuidv7()).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // postgresql://app_logitrans:***@127.0.0.1:5432/logitrans?schema=public
}

model Cliente {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  razonSocial      String              @map("razon_social") @db.VarChar(150)
  rfc              String?             @db.VarChar(13)
  email            String              @unique @db.VarChar(120)
  passwordHash     String              @map("password_hash") @db.VarChar(100)
  totpSecreto      Bytes?              @map("totp_secreto")
  totpActivo       Boolean             @default(false) @map("totp_activo")
  emailVerificado  Boolean             @default(false) @map("email_verificado")
  intentosFallidos Int                 @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime?           @map("bloqueado_hasta") @db.Timestamptz(6)
  creadoEn         DateTime            @default(now()) @map("creado_en") @db.Timestamptz(6)
  envios           Envio[]
  tokens           TokenVerificacion[]

  @@map("clientes")
}

model TokenVerificacion {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clienteId String   @map("cliente_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiraEn  DateTime @map("expira_en") @db.Timestamptz(6)
  usado     Boolean  @default(false)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("tokens_verificacion")
}

model Empleado {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  adObjectGuid String           @unique @map("ad_object_guid") @db.Uuid
  usuarioAD    String           @map("usuario_ad") @db.VarChar(20)
  nombre       String           @db.VarChar(120)
  rol          String           @db.VarChar(20)
  activo       Boolean          @default(true)
  ultimoAcceso DateTime?        @map("ultimo_acceso") @db.Timestamptz(6)
  rutas        Ruta[]
  cambios      HistorialEnvio[]

  @@map("empleados")
}

model Vehiculo {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  placas      String  @unique @db.VarChar(10)
  descripcion String  @db.VarChar(100)
  capacidadKg Decimal @map("capacidad_kg") @db.Decimal(10, 2)
  activo      Boolean @default(true)
  rutas       Ruta[]

  @@map("vehiculos")
}

model Ruta {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  nombre     String   @db.VarChar(100)
  fecha      DateTime @db.Date
  choferId   String   @map("chofer_id") @db.Uuid
  vehiculoId String   @map("vehiculo_id") @db.Uuid
  estado     String   @default("PLANEADA") @db.VarChar(20)
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  chofer     Empleado @relation(fields: [choferId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  envios     Envio[]

  @@map("rutas")
}

model Envio {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  folioRastreo     String           @unique @map("folio_rastreo") @db.VarChar(16)
  clienteId        String           @map("cliente_id") @db.Uuid
  rutaId           String?          @map("ruta_id") @db.Uuid
  direccionOrigen  String           @map("direccion_origen") @db.VarChar(250)
  direccionDestino String           @map("direccion_destino") @db.VarChar(250)
  descripcion      String           @db.VarChar(250)
  pesoKg           Decimal          @map("peso_kg") @db.Decimal(8, 2)
  estado           String           @default("SOLICITADO") @db.VarChar(20)
  creadoEn         DateTime         @default(now()) @map("creado_en") @db.Timestamptz(6)
  entregadoEn      DateTime?        @map("entregado_en") @db.Timestamptz(6)
  cliente          Cliente          @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ruta             Ruta?            @relation(fields: [rutaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  historial        HistorialEnvio[]

  @@map("envios")
}

model HistorialEnvio {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  envioId    String    @map("envio_id") @db.Uuid
  estado     String    @db.VarChar(20)
  comentario String?   @db.VarChar(250)
  empleadoId String?   @map("empleado_id") @db.Uuid
  fecha      DateTime  @default(now()) @db.Timestamptz(6)
  envio      Envio     @relation(fields: [envioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  empleado   Empleado? @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("historial_envio")
}

model Bitacora {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fecha       DateTime @default(now()) @db.Timestamptz(6)
  tipoUsuario String   @map("tipo_usuario") @db.VarChar(10)
  usuarioId   String?  @map("usuario_id") @db.Uuid
  accion      String   @db.VarChar(50)
  recurso     String   @db.VarChar(250)
  ip          String   @db.VarChar(45)
  resultado   String   @db.VarChar(10)

  @@map("bitacora")
}

model TokenRevocado {
  jti       String   @id @db.VarChar(64)
  usuarioId String   @map("usuario_id") @db.Uuid
  expiraEn  DateTime @map("expira_en") @db.Timestamptz(6)

  @@map("tokens_revocados")
}
